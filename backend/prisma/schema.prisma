datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Empresa {
  id                    String     @id @default(uuid())
  rut                   String     @unique
  nombre                String
  razon_social          String?
  domicilio_constituido String?
  domicilio_fiscal      String?
  telefono              String?
  email                 String?
  giro                  String?
  codigo_ciiu           String?
  fecha_balance         String?
  tipo_contribuyente    String?
  proyectos             Proyecto[]
  accesos               UsuarioEmpresa[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

// Permisos de un usuario sobre una empresa.
//
// La sola existencia de la fila otorga LECTURA. `escritura` lista los módulos
// que además puede modificar ('empresa', 'proyectos', 'facturas', 'checklist',
// 'simulador'); vacío = sólo lectura.
//
// Los administradores no tienen filas acá: acceden a todo por su rol.
// `usuarioSub` es el `sub` de Cognito, que es estable y no cambia si el
// usuario cambia de email.
model UsuarioEmpresa {
  id         String   @id @default(uuid())
  usuarioSub String
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  escritura  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([usuarioSub, empresaId])
  @@index([usuarioSub])
}

model Proyecto {
  id                   String     @id @default(uuid())
  empresaId            String
  empresa              Empresa    @relation(fields: [empresaId], references: [id])
  fecha_creacion       String
  fecha_presentacion   String?
  anio_presentacion    Int?
  duracion_seguimiento Int?
  cotizacion_ui        Float?
  cotizacion_usd       Float?
  expediente           String?
  checklists           ChecklistItem[]
  facturas             Factura[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([empresaId])
}

model ChecklistItem {
  id           String     @id @default(uuid())
  proyectoId   String
  proyecto     Proyecto   @relation(fields: [proyectoId], references: [id])
  periodo      String
  item_id      String
  estado       String     @default("pendiente")
  archivo      String?
  nota_usuario String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([proyectoId, periodo, item_id])
}

model Factura {
  id                    String    @id @default(uuid())
  proyectoId            String?
  proyecto              Proyecto? @relation(fields: [proyectoId], references: [id])
  periodo               String?
  archivo               String?
  descripcion           String?
  numero_factura        String?
  proveedor             String?
  rut                   String?
  fecha                 String?
  monto                 Float?
  moneda                String?
  cantidad              Int?      @default(1)
  categoria             String?
  rut_receptor          String?
  razon_social_receptor String?
  tipo_comprobante      String?
  fecha_ejecucion       String?
  texto_extraido        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([proyectoId, periodo])
}

model Cotizacion {
  id        String   @id
  fecha     String   @unique
  valor_ui  Float
  valor_usd Float
  createdAt DateTime @default(now())
}
