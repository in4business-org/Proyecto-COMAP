# ── App ───────────────────────────────────────────────
GEMINI_API_KEY=
PORT=3001

# ── Base de datos (Postgres) ──────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── AWS S3 (almacenamiento de archivos) ───────────────
# OJO: en Vercel usar nombres S3_* (los AWS_* están reservados por Lambda).
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AWS Cognito (autenticación) ───────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
