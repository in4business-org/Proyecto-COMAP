# ── App ───────────────────────────────────────────────
GEMINI_API_KEY=
PORT=3001

# ── Base de datos (Postgres) ──────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── AWS S3 (almacenamiento de archivos) ───────────────
# OJO: en Vercel usar nombres S3_* (los AWS_* están reservados por Lambda).
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AWS Cognito (autenticación) ───────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Credenciales para administrar usuarios desde el panel de admin
# (AdminCreateUser, grupos, etc). Ver ADMIN_SETUP.md para la policy de IAM.
# Si se omiten, caen a S3_* / AWS_* o al IAM Role de la instancia.
COGNITO_REGION=us-east-1
COGNITO_ACCESS_KEY_ID=
COGNITO_SECRET_ACCESS_KEY=
